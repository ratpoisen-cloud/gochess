# Firebase Configuration (обязательно)
# Копируйте в .env.local и заполните реальные значения.
# .env.local находится в .gitignore и не должен попадать в репозиторий.
#
# Значения берутся в консоли Firebase:
#   Project settings → Your apps → Web app → SDK setup and configuration → Config
#
# Для CI достаточно заглушек: сборке нужно лишь наличие ключей.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=